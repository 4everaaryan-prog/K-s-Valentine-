<!DOCTYPE html>
<html>
<head>
<title>Kritika ❤️</title>

<!-- Confetti -->
<script src="https://cdn.jsdelivr.net/npm/canvas-confetti@1.6.0/dist/confetti.browser.min.js"></script>

<style>
body {
  text-align: center;
  font-family: Arial, sans-serif;
  background: linear-gradient(to right, #ff758c, #ff7eb3);
  color: white;
  margin-top: 100px;
  overflow: hidden;
}

button {
  padding: 15px 30px;
  font-size: 20px;
  margin: 10px;
  border: none;
  border-radius: 25px;
  cursor: pointer;
  transition: 0.3s;
}

#yesBtn {
  background-color: #ff0066;
  color: white;
}

#noBtn {
  background-color: white;
  color: #ff0066;
  position: absolute;
}

#message {
  margin-top: 40px;
  font-size: 22px;
  width: 70%;
  margin-left: auto;
  margin-right: auto;
}
</style>
</head>

<body>

<h1>Kritika, Will You Be My Valentine? 💖</h1>

<button id="yesBtn" onclick="celebrate()">YES ❤️</button>
<button id="noBtn" onmouseover="moveNo()">NO 😜</button>

<div id="message"></div>

<script>

let yesSize = 20;

function moveNo() {
  let x = Math.random() * (window.innerWidth - 100);
  let y = Math.random() * (window.innerHeight - 100);
  document.getElementById("noBtn").style.left = x + "px";
  document.getElementById("noBtn").style.top = y + "px";

  yesSize += 5;
  document.getElementById("yesBtn").style.fontSize = yesSize + "px";
}

function celebrate() {
  confetti({
    particleCount: 200,
    spread: 100
  });

  document.body.innerHTML = `
  <h1>Aryan ❤️ Kritika</h1>
  <h2>You are the love of my life 💘</h2>
  <p style="width:70%; margin:auto; font-size:20px;">
  Kritika, I still remember the time we spent together in the library,
  sitting close, pretending to study but actually stealing glances at you.
  Those small moments meant everything to me.
  From quiet talks to shared smiles,
  you became my favorite memory and my forever dream.
  I love you more than words can explain ❤️
  </p>
  <h2>Forever Yours, Aryan 💖</h2>
  `;

  setTimeout(() => {
    confetti({
      particleCount: 150,
      spread: 120
    });
  }, 500);
}

</script>

</body>
</html>
